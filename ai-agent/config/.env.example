BACKEND_URL=http://localhost:3333
BACKEND_API_KEY=your_backend_api_key
REDIS_URL=redis://localhost:6379/0
AI_RATE_LIMIT_PER_MINUTE=20
AI_REQUIRE_REDIS=false
AI_CHAT_HISTORY_MAX_MESSAGES=20
AI_TIMEZONE=Asia/Ho_Chi_Minh
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LLM_API_MODE=responses # supported: responses, chat_completions
AGENT_ORCHESTRATOR=langgraph # supported: langgraph, legacy
AGENT_MAX_GRAPH_STEPS=12
AGENT_GRAPH_TIMEOUT_SECONDS=90
AGENT_MAX_EMPTY_TOOL_STREAK=2
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=quiz-online-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_PROVIDER=openai # or anthropic
WEB_SEARCH_PROVIDER=disabled # supported: disabled, tavily; use only as fallback after internal data
WEB_SEARCH_API_KEY=
CORS_ORIGINS=http://localhost:5173
PORT=8000
