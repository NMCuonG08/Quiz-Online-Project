BACKEND_URL=http://localhost:3333
BACKEND_API_KEY=your_backend_api_key
REDIS_URL=redis://localhost:6379/0
# Use a least-privilege Postgres URL for LangGraph checkpoints in production.
AI_CHECKPOINT_DATABASE_URL=postgresql://quiz_agent_checkpoint:password@localhost:5432/quiz
AGENT_CHECKPOINTER=postgres # supported: postgres, disabled
AI_RATE_LIMIT_PER_MINUTE=20
# Production should keep this true; set false only for single-instance local development.
AI_REQUIRE_REDIS=true
AI_CHAT_HISTORY_MAX_MESSAGES=20
# Context and memory are bounded per run/namespace.
AI_CONTEXT_MAX_HISTORY_CHARS=12000
AI_CONTEXT_MAX_SECTION_CHARS=8000
AI_CONTEXT_MAX_TOTAL_CHARS=40000
AI_MEMORY_MAX_ITEMS=200
AI_MEMORY_TTL_SECONDS=2592000
AI_TIMEZONE=Asia/Ho_Chi_Minh
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AI_EXECUTOR_MODEL=gpt-5.6-terra
AI_EXECUTOR_API_KEY=
AI_EXECUTOR_BASE_URL=
AI_EXECUTOR_PROVIDER=openai # openai-compatible or anthropic
AI_EXECUTOR_REASONING_EFFORT=medium
# The fallback must support the same tool-calling contract as the executor.
AI_EXECUTOR_FALLBACK_MODEL=gpt-4.1-mini
AI_EXECUTOR_FALLBACK_API_KEY=
AI_EXECUTOR_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_EXECUTOR_FALLBACK_PROVIDER=openai
# For a real provider failover, use e.g. provider=anthropic, model=claude-3-5-haiku-latest,
# and set AI_EXECUTOR_FALLBACK_API_KEY to ANTHROPIC_API_KEY.
# Per-attempt limits preserve provider latency; the graph deadline remains a hard upper bound.
AI_EXECUTOR_ATTEMPT_TIMEOUT_SECONDS=60
AI_EXECUTOR_FALLBACK_TIMEOUT_SECONDS=60
AI_EXECUTOR_TIMEOUT_SECONDS=60
AI_REVIEWER_MODEL=
AI_REVIEWER_API_KEY=
AI_REVIEWER_BASE_URL=
AI_REVIEWER_TIMEOUT_SECONDS=25
LLM_API_MODE=responses # supported: responses, chat_completions
AGENT_ORCHESTRATOR=langgraph # supported: langgraph, legacy
# supervisor_v1 enables controlled planner + worker fan-out for complex authoring.
# agent_first is the current default; planner_legacy is the compatibility rollback.
AI_ORCHESTRATION_MODE=agent_first # supported: agent_first, planner_legacy, supervisor_v1
AI_SUPERVISOR_MAX_QUESTIONS_PER_WORKER=4
AI_SUPERVISOR_MEDIA_CONCURRENCY=4
AI_SUPERVISOR_MEDIA_TIMEOUT_SECONDS=6
AI_SUPERVISOR_DEFAULT_QUESTION_COUNT=8
AI_SUPERVISOR_MAX_REVISIONS=2
# Semantic intent routing: fast model handles clear reads; strong model verifies
# ambiguous, multi-intent, write, destructive and admin requests.
AI_PLANNER_FAST_MODEL=gemini-2.5-flash
AI_PLANNER_FAST_API_KEY=
AI_PLANNER_FAST_BASE_URL=https://api.openai.com/v1
AI_PLANNER_FAST_REASONING_EFFORT=none
AI_PLANNER_FAST_TIMEOUT_SECONDS=8
AI_PLANNER_STRONG_MODEL=gpt-5.4-high
AI_PLANNER_STRONG_API_KEY=
AI_PLANNER_STRONG_BASE_URL=https://api.openai.com/v1
AI_PLANNER_STRONG_REASONING_EFFORT=medium
AI_PLANNER_STRONG_TIMEOUT_SECONDS=25
AI_PLANNER_CONFIDENCE_THRESHOLD=0.82
AI_PLANNER_ESCALATE_WRITES=false
AI_MODEL_MAX_RETRIES=0
AI_MODEL_FAILURE_THRESHOLD=2
AI_MODEL_COOLDOWN_SECONDS=30
# Set true for official OpenAI Responses API; keep false for providers that only emulate Chat Completions.
AI_LANGGRAPH_USE_RESPONSES_API=false
AGENT_MAX_GRAPH_STEPS=12
AGENT_GRAPH_TIMEOUT_SECONDS=90
AI_AUTO_IMAGE_TIMEOUT_SECONDS=8
AGENT_MAX_EMPTY_TOOL_STREAK=2
# Harness budgets: hard per-run limits shared by planner and executor.
AGENT_MAX_MODEL_CALLS=24
AGENT_MAX_TOOL_CALLS=32
AGENT_MAX_SUBAGENT_CALLS=8
AGENT_MAX_TOTAL_TOKENS=100000
AGENT_MAX_COST_USD=5
AGENT_VERSION=quiz-agent-dev
AGENT_RUN_TTL_SECONDS=604800
AGENT_MAX_EVENTS_PER_RUN=2000
AGENT_CREDENTIAL_TTL_SECONDS=600
AGENT_QUEUE_KEY_PREFIX=quiz-ai:queue:
AGENT_QUEUE_LEASE_TTL_SECONDS=300
AGENT_WORKER_POLL_TIMEOUT_SECONDS=2
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=quiz-online-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_PROVIDER=openai # or anthropic
WEB_SEARCH_PROVIDER=disabled # supported: disabled, tavily; use only as fallback after internal data
WEB_SEARCH_API_KEY=
CORS_ORIGINS=http://localhost:5173
PORT=8000
